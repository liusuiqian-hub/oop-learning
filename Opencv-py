向左旋转45°
import cv2 as cv
import numpy as np
import matplotlib.pyplot as plt
# 1. 读取图片
img = cv.imread("myphoto.jpg")
if img is None:
print("图片读取失败")
else:
# 2. 获取图片尺寸和中心点
h, w = img.shape[:2]
center = (w // 2, h // 2)
# 3. 计算旋转矩阵
# 角度为负值 = 逆时针（向左）旋转
M = cv.getRotationMatrix2D(center, -45, 1.0)
# 4. 执行旋转
rotated = cv.warpAffine(img, M, (w, h))
# 5. 显示结果
plt.imshow(cv.cvtColor(rotated, cv.COLOR_BGR2RGB))
plt.title("向左旋转 45°")
plt.show()
