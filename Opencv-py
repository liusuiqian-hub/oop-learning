图片背景变成黑色
import cv2 as cv
import numpy as np
import matplotlib.pyplot as plt
# 1. 读取图片
img = cv.imread("myphoto.jpg")
# 2. 检查是否读取成功
if img is None:
print("图片读取失败，请检查文件名和路径")
else:
# 3. 转灰度
gray = cv.cvtColor(img, cv.COLOR_BGR2GRAY)
# 4. 用 Otsu 自动找阈值
# 注意：背景是白色（亮），文字是深色（暗）
# THRESH_BINARY_INV 会把"亮色背景"变成白色，文字变成黑色
_, mask = cv.threshold(gray, 0, 255, cv.THRESH_BINARY_INV + cv.THRESH_OTSU)
# 5. 创建黑色背景
result = np.zeros_like(img)  # 全黑
# 6. 把文字（mask 中白色的部分）复制到黑色背景上
result[mask == 255] = img[mask == 255]
# 7. 显示结果
plt.imshow(cv.cvtColor(result, cv.COLOR_BGR2RGB))
plt.show()
