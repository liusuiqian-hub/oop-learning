####################################################################################
用红线勾勒字体
#include <opencv2/opencv.hpp>
using namespace cv;
using namespace std;
int main() {
Mat img = imread("myphoto.jpg");
if (img.empty()) {
return -1;
}
Mat gray;
cvtColor(img, gray, COLOR_BGR2GRAY);
Mat binary;
threshold(gray, binary, 0, 255, THRESH_BINARY_INV | THRESH_OTSU);
Mat kernel = getStructuringElement(MORPH_RECT, Size(5, 5));
Mat dilated;
dilate(binary, dilated, kernel);
vector<vector<Point>> contours;
findContours(dilated, contours, RETR_EXTERNAL, CHAIN_APPROX_SIMPLE);
Mat result = img.clone();
drawContours(result, contours, -1, Scalar(0, 0, 255), 2);
imshow("Original", img);
imshow("Binary", binary);
imshow("Dilated", dilated);
imshow("Result", result);
waitKey(0);
return 0;
}
####################################################################################
向左旋转45°
#include <opencv2/opencv.hpp>
using namespace cv;
using namespace std;
int main() {
Mat img = imread("myphoto.jpg");
if (img.empty()) {
return -1;
}
Point2f center(img.cols / 2.0f, img.rows / 2.0f);
double angle = -45.0;
double scale = 1.0;
Mat rotMat = getRotationMatrix2D(center, angle, scale);
double cos = abs(rotMat.at<double>(0, 0));
double sin = abs(rotMat.at<double>(0, 1));
int newWidth = img.rows * sin + img.cols * cos;
int newHeight = img.rows * cos + img.cols * sin;
rotMat.at<double>(0, 2) += (newWidth - img.cols) / 2.0;
rotMat.at<double>(1, 2) += (newHeight - img.rows) / 2.0;
Mat rotated;
warpAffine(img, rotated, rotMat, Size(newWidth, newHeight));
imshow("Original", img);
imshow("Rotated 45°", rotated);
waitKey(0);
 return 0;
}
